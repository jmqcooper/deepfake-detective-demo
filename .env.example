# Docker persists /app/data in a named volume. To change the filename, keep it
# inside that mount (for example /app/data/museum-stats.db).
DATABASE_PATH=/app/data/stats.db

# Stats backend: "sqlite" persists to DATABASE_PATH; "memory" needs no infrastructure.
STATS_DRIVER=sqlite

# Museum reporting day. REPORT_TIMEZONE takes precedence over TZ; both default
# to Amsterdam in the image and Compose deployment.
TZ=Europe/Amsterdam
REPORT_TIMEZONE=Europe/Amsterdam

# Set the same random value in the native voice service's environment on a
# server. Local development may leave this empty.
VOICE_CLONE_TOKEN=

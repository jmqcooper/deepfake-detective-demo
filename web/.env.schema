# ilcc-deepfake environment contract. Names and rules live here, values never do.
#
# Tags name the process that reads a variable:
#
#   #web    the Next.js app: `next dev`, `next start` and the container image
#   #ops    operator commands in ops/, including stats-maintenance.mjs in the container
#   #voice  the native voice service, tools/voice_clone_service.py
#   #tools  the test harness and the offline media pipeline
#
# Profiles select what must be present:
#
#   installed    the container image, the normal way to run this demo
#   production   next build, next start and anything under CI: types only, no shared store
#   development  everything else, including npm run dev: types only, and Infisical loads
#
# Voice cloning is an add-on, so nothing about it is required in any profile.
#
# Readers keep their own parsing. Numbers and flags are checked here as raw text, because
# Varlock's number and boolean types accept forms the readers treat differently.
#
# docs/SECRETS.md covers the stores, a new machine and the credential proxy.
#
# @currentEnv=$ILCC_ENV_PROFILE
# @defaultRequired=false
# @defaultSensitive=inferFromPrefix(NEXT_PUBLIC_)
# @defaultDynamic=true
# @import(./.env.infisical, enabled=and(forEnv(development), not(eq($ILCC_SHARED_SECRETS, off))), allowMissing=true)
# The identity key is declared by the optional import, which audits may run without.
# @auditIgnoreKeys(__VARLOCK_ENV, INFISICAL_CLIENT_ID)
# @auditExtraPatterns(regex('\bos\.environ(?:\.get\(\s*|\[\s*)["]([A-Z][A-Z0-9_]*)["]'), fileTypes=[py, sh, slurm])
# @auditExtraPatterns(regex('[$][{]([A-Z][A-Z0-9_]*):-'), fileTypes=[sh, slurm])
# ---

# @sensitive=false
CI=

# @tag(web) @sensitive=false
NODE_ENV=

# The image sets this outright. Everywhere else it follows CI and NODE_ENV.
# @sensitive=false @internal @type=enum(development, production, installed)
ILCC_ENV_PROFILE=ifs($CI, production, eq($NODE_ENV, production), production, development)

# off keeps a process on this machine's values alone.
# @sensitive=false @internal @type=enum(infisical, off)
ILCC_SHARED_SECRETS=

# ------------------------------------------------------------
# Web server
# ------------------------------------------------------------

# Read by the server.js that Next generates: parseInt, then 3000 for zero or blank.
# @tag(web) @sensitive=false @auditIgnore @type=string(matches=regex("^[ \t]*\+?0*([0-9]{1,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])[ \t]*$"))
PORT=

# @tag(web) @sensitive=false @auditIgnore
HOSTNAME=

# @tag(web) @sensitive=false @auditIgnore
NEXT_TELEMETRY_DISABLED=

# @tag(web) @sensitive=false @auditIgnore
VARLOCK_TELEMETRY_DISABLED=

# ------------------------------------------------------------
# Statistics
# ------------------------------------------------------------

# memory needs no database. Anything else leaves the demo running with stats off.
# @tag(web) @sensitive=false @required=forEnv(installed) @type=enum(memory, sqlite)
STATS_DRIVER=

# A blank path points SQLite at a directory, so the image needs a real one.
# @tag(web, ops) @sensitive=false @required=and(forEnv(installed), not(eq($STATS_DRIVER, memory)))
DATABASE_PATH=

# Whole numbers. The web app clamps these to its limits. The prune command refuses a
# retention outside 1 to 3650 days itself, and a kiosk should still boot with one.
# @tag(web, ops) @sensitive=false @type=string(matches=regex("^[ \t]*[+-]?[0-9]+[ \t]*$"))
STATS_RETENTION_DAYS=

# @tag(web) @sensitive=false @type=string(matches=regex("^[ \t]*[+-]?[0-9]+[ \t]*$"))
STATS_MAX_ROWS=

# @tag(web) @sensitive=false @type=string(matches=regex("^[ \t]*[+-]?[0-9]+[ \t]*$"))
STATS_MAX_MEMORY_EVENTS=

# Wins over TZ. The app logs a name it cannot use and falls back to Amsterdam.
# @tag(web) @sensitive=false
REPORT_TIMEZONE=

# Free text: a host can legitimately carry a POSIX form such as :/etc/localtime.
# @tag(web) @sensitive=false
TZ=

# ------------------------------------------------------------
# Voice service link. Optional: without a live service the station stays hidden.
# ------------------------------------------------------------

# @tag(web) @sensitive=false @type=url(allowedProtocols=[http, https])
VOICE_CLONE_URL=

# Generated per install and shared with the voice service. Never seed it into the
# store. Sent as a header and compared as ASCII, so printable ASCII only, with no space
# at either end, which a header would strip.
# @tag(web, voice) @type=string(matches=regex("^[\x21-\x7e]([\x20-\x7e]*[\x21-\x7e])?$"))
VOICE_CLONE_TOKEN=

# ------------------------------------------------------------
# Voice service, tools/voice_settings.py
# ------------------------------------------------------------
# Python runs this service where no Node exists, so an installed host never loads this
# file. tools/tests/voice-env-cases.json holds these rules to the Python readers.

# @tag(voice) @sensitive=false
VOICE_CLONE_HOST=

# @tag(voice) @sensitive=false @type=string(matches=regex("^[ \t]*\+?0*([0-9]{1,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])[ \t]*$"))
VOICE_CLONE_PORT=

# @tag(voice) @sensitive=false @type=string(matches=regex("^[ \t]*[0-9]+[ \t]*$"))
VOICE_CLONE_SOCKET_FD=

# @tag(voice) @sensitive=false @type=string(matches=regex("^[ \t]*(auto|cuda|mps|cpu)[ \t]*$", "i"))
VOICE_CLONE_DEVICE=

# @tag(voice) @sensitive=false @type=string(matches=regex("^[ \t]*[+-]?[0-9]+(_[0-9]+)*[ \t]*$"))
VOICE_CLONE_IDLE_SECONDS=

# The reader treats any unknown word as off, so `on` would silently do nothing.
# @tag(voice) @sensitive=false @type=string(matches=regex("^(0|1|true|false|yes|no)$", "i"))
VOICE_CLONE_EXIT_ON_IDLE=

# @tag(voice) @sensitive=false @type=string(matches=regex("^(0|1|true|false|yes|no)$", "i"))
VOICE_CLONE_EAGER=

# @tag(voice) @sensitive=false @type=string(matches=regex("^(0|1|true|false|yes|no)$", "i"))
VOICE_CLONE_REQUIRE_TOKEN=

# Only needed for a gated or rate-limited model download.
# @tag(voice)
# @proxy(domain="huggingface.co", substituteIn=["header:authorization"])
# @placeholder=hf_placeholder000000000000000000000000
HF_TOKEN=

# ------------------------------------------------------------
# Operator commands
# ------------------------------------------------------------

# @tag(ops) @sensitive=false
BACKUP_DIR=

# @tag(ops) @sensitive=false @type=url(allowedProtocols=[http, https])
APP_URL=

# @tag(ops) @sensitive=false @type=string(matches=regex("^[0-9]+$"))
VOICE_READY_TIMEOUT_SECONDS=

# @tag(ops) @sensitive=false
VOICE_SAMPLE_WAV=

# @tag(ops) @sensitive=false @type=enum(nl, en)
VOICE_SAMPLE_LANG=

# @tag(ops) @sensitive=false @type=url(allowedProtocols=[http, https])
KIOSK_URL=

# @tag(ops) @sensitive=false
KIOSK_BROWSER=

# @tag(ops) @sensitive=false
KIOSK_DISPLAY_OUTPUT=

# @tag(ops) @sensitive=false
KIOSK_ROTATION=

# ------------------------------------------------------------
# Test harness and offline media pipeline
# ------------------------------------------------------------

# @tag(tools) @sensitive=false @type=url(allowedProtocols=[http, https])
E2E_BASE_URL=

# @tag(tools) @sensitive=false @type=url(allowedProtocols=[http, https])
SMOKE_URL=

# @tag(tools) @sensitive=false @type=string(matches=regex("^[0-9]+$"))
E2E_PORT=

# A fixture for pipeline and container tests. It never replaces the curated pack.
# @tag(tools) @sensitive=false @auditIgnore @type=enum(0, 1)
FORCE_SYNTHETIC_SAMPLES=

# @tag(tools) @sensitive=false @type=string(matches=regex("^[0-9]+$"))
SOURCE_DATE_EPOCH=

# @tag(tools) @sensitive=false
SNELLIUS_HOST=

# The job settings below belong to tools/snellius, which runs on the Snellius cluster.

# @tag(tools) @sensitive=false
OUT=

# @tag(tools) @sensitive=false
PROJ=

# @tag(tools) @sensitive=false @type=string(matches=regex("^[0-9]+$"))
N=

# @tag(tools) @sensitive=false
MODE=

# @tag(tools) @sensitive=false
LANGS=

# @tag(tools) @sensitive=false
VENV=

# @tag(tools) @sensitive=false
HF_HOME=

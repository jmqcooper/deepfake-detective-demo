# Shared development values. .env.schema imports this file on development machines only,
# and the image and release archives leave it out.
#
# The identity lives in a private file per host, shared by every project on it:
# INFISICAL_CLIENT_ID and the locally encrypted INFISICAL_CLIENT_SECRET, mode 0600.
# Without one, this file does nothing and local env files work alone.
#
# @defaultRequired=false
# @plugin(@varlock/infisical-plugin)
# @import(~/.config/varlock/.env.infisical, allowMissing=true)
# @initInfisical(siteUrl=$INFISICAL_SITE_URL, projectId=$INFISICAL_PROJECT_ID, environment=$INFISICAL_ENVIRONMENT, clientId=$INFISICAL_CLIENT_ID, clientSecret=$INFISICAL_CLIENT_SECRET)
# @setValuesBulk(infisicalBulk(), enabled=not(isEmpty($INFISICAL_CLIENT_ID)))
# ---

# @sensitive=false @internal @type=url
INFISICAL_SITE_URL=https://eu.infisical.com

# @sensitive=false @internal
INFISICAL_ENVIRONMENT=dev

# @sensitive=false @internal
INFISICAL_PROJECT_ID=d94dd105-6501-4335-933a-9fee64af98b4

# @type=infisicalClientId @internal
INFISICAL_CLIENT_ID=

# @type=infisicalClientSecret @sensitive @internal @required=not(isEmpty($INFISICAL_CLIENT_ID))
INFISICAL_CLIENT_SECRET=

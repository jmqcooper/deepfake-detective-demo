[Unit]
Description=ilcc-deepfake kiosk browser
After=graphical.target docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ilcc-deepfake
Environment=DISPLAY=:0
Environment=KIOSK_URL=http://127.0.0.1:3000
Environment=KIOSK_BROWSER=chromium
ExecStart=/opt/ilcc-deepfake/ops/kiosk-launch.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target

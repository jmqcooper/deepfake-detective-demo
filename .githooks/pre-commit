#!/bin/sh
set -eu

[ -n "$(git diff --cached --name-only --diff-filter=ACMRT)" ] || exit 0

fail() {
  printf '%s\n' 'Secret scan failed. Check staged files and secret-store access. See docs/SECRETS.md.' >&2
  exit 1
}

# varlock scan --staged reads the working copy, so scan a copy of the index.
# The path is literal because Varlock expands any target with a glob character.
index_copy="$(mktemp -d /tmp/ilcc-deepfake-staged.XXXXXXXX)"
trap 'rm -rf "$index_copy"' EXIT
trap 'exit 1' HUP INT TERM
git diff --cached --name-only -z --diff-filter=ACMRT >"$index_copy/paths"
mkdir "$index_copy/files"
git checkout-index -z --stdin --prefix="$index_copy/files/" <"$index_copy/paths"

# Varlock's report can print a second secret from the same line, so only the status is used.
node web/scripts/scan-staged.mjs "$index_copy" >/dev/null 2>&1 || fail

# The installed web-to-voice token lives in the root .env, which the schema never loads.
# This comes after the proxy check. grep also reads the files Varlock skips, and the pipe
# keeps the token out of any file or argument.
token="$(sed -n 's/^VOICE_CLONE_TOKEN=//p' .env 2>/dev/null | tail -n 1 | tr -d '\r')"
if [ -n "$token" ]; then
  found=0
  printf '%s\n' "$token" | grep -rqFf - "$index_copy/files" || found=$?
  [ "$found" -eq 1 ] || fail
fi
